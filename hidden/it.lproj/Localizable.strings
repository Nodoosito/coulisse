"Add a Profile" = "Aggiungi un profilo";
"Default" = "Predefinito";
"Profile %d" = "Profilo %d";
"Manual" = "Manuale";
"Any external display connected" = "Qualsiasi monitor esterno collegato";
"Display “%@” connected" = "Monitor “%@” collegato";
"No external display" = "Nessun monitor esterno";
"On battery" = "A batteria";
"On power adapter" = "Con alimentatore";
"Use" = "Usa";
"Active" = "Attivo";
"Profile" = "Profilo";
